# =====================================================================================
#  SECRETS DE LA PASSERELLE WHATSAPP
#
#  Copiez ce fichier en `evolution/.env` et remplissez-le. Le vrai fichier est
#  couvert par `.gitignore` et n'entre JAMAIS dans Git : prévoyez explicitement
#  son transport lors d'un déménagement de poste.
#
#  Générer une valeur aléatoire (PowerShell) :
#      -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Max 256) })
# =====================================================================================

# ─── Tailscale ────────────────────────────────────────────────────────────────
# Clé d'authentification : Settings → Keys → Generate auth key.
#   • cochée REUSABLE
#   • surtout PAS Ephemeral — un nœud éphémère est supprimé dès qu'il se
#     déconnecte et revient sous un nom différent, ce qui CHANGE l'adresse
#     publique et coupe l'application sans prévenir.
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Le nom du nœud. Il ne se récupère nulle part : C'EST UN NOM QUE VOUS CHOISISSEZ.
# Il forme la première moitié de l'adresse publique.
TAILSCALE_HOSTNAME=rclmc-wa

# L'adresse publique complète : https:// + TAILSCALE_HOSTNAME + . + nom du tailnet.
# Le nom du tailnet se lit dans la console Tailscale → DNS (ex. tail6ac334.ts.net).
# SANS SLASH FINAL — cette valeur est comparée au caractère près par le webhook.
TUNNEL_PUBLIC_URL=https://rclmc-wa.tailXXXXXX.ts.net

# ─── Passerelle Evolution ─────────────────────────────────────────────────────
# Doit valoir EXACTEMENT `EVOLUTION_API_KEY` côté application (chez l'hébergeur).
# Ne réutilisez jamais la clé d'un autre projet : deux organisations ne doivent
# pas partager un secret.
EVOLUTION_API_KEY=remplacez-par-32-octets-aleatoires

# Mot de passe de la base de la passerelle.
# ⚠️ Il n'est appliqué qu'à l'INITIALISATION du volume Postgres. Le modifier
#    ensuite fait rejeter la connexion et la passerelle ne démarre plus.
POSTGRES_PASSWORD=remplacez-par-32-octets-aleatoires
